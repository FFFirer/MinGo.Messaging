{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Messaging": {
    "Integrations": {
      "RabbitMQ": {
        "Type": "RabbitMQ",
        "ConnectionString": "amqp://guest:guest@localhost:5672",
        "Exchange": "amq.topic",
        "ExchangeType": "topic",
        "Durable": true,
        "PrefetchCount": 10
      }
    },
    "Publishers": {
      "OrderBus": {
        "Integration": "RabbitMQ"
      }
    }
  }
}
