{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Messaging": {
    "Integrations": {
      "SimpleMessageBroker": {
        "Type": "SimpleMessageBroker",
        "BaseAddress": "http://localhost:5292",
        "PollingInterval": "00:00:01",
        "BatchSize": 10,
        "ConsumeTimeoutSeconds": 5
      }
    },
    "Publishers": {
      "OrderBus": {
        "Integration": "SimpleMessageBroker"
      }
    }
  }
}
